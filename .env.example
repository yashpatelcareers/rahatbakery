# Google Places API (New) Configuration for Rahat Bakery
# Business: Rahat Bakers and Sweets, 13919 Baltimore Ave, Laurel, MD 20707

# 1. Google Cloud API Key with Places API (New) enabled (Keep Private & Server-Side Only)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# 2. Google Place ID for Rahat Bakers and Sweets (Laurel, MD)
# Obtain via Google Place ID Finder: https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=your_google_place_id_here

# 3. Optional Public Site URL
NEXT_PUBLIC_SITE_URL=https://rahatbakery.vercel.app
