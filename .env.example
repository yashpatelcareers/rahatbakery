# ==============================================================================
# RAHAT BAKERY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your Vercel Project Settings.

# 1. Supabase Persistent Database & Storage Configuration (Required for Production CMS Persistence)
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Google Places API (New) Configuration (Optional for Live Google Reviews)
# Business: Rahat Bakers and Sweets, 13919 Baltimore Ave, Laurel, MD 20707
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here

# 3. Optional Public Site URL
NEXT_PUBLIC_SITE_URL=https://rahatbakery.vercel.app

# 4. Admin Portal Authentication Credentials (Defaults to admin / rahatadmin2026 if unset)
ADMIN_USERNAME=your_username_here
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_random_session_secret_hash_here
